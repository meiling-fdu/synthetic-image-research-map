  <main id="main">
    <section class="hero">
        <div class="container hero-inner">
          <div class="hero-copy">
            <h1>Published Papers &amp; Proceedings</h1>
            <p>Contributed papers and proceedings for CVWW 2026.</p>
            <div class="cta">
              <a class="btn btn-primary" href="assets/pdfs/CVWW26_proceedings.pdf">Proceedings in PDF</a>
            </div>
          </div>
        </div>
      </section>

    <section id="published-papers" class="section alt">
      <div class="container">
        <h2>Contributed Papers</h2>

        <div class="published-panel">
          <div class="published-panel-body">
            <ul class="talk-list">
              <li class="accepted"><span class="talk-desc"><strong>Instantaneous Monocular
                Camera Tilt Stabilization for Autonomous Student Formula</strong><br>Erik Doležal, Jan Čech<br>
                  <span class="talk-links">
                    <a class="link" href="assets/pdfs/CVWW2026-13-final.pdf" target="_blank" rel="noopener">Paper</a>
                  </span>
                </span>
              </li>
            </ul>
          </div>
        </div>
        <div class="published-panel">
          <div class="published-panel-body">
            <ul class="talk-list">
              <li class="accepted"><span class="talk-desc"><strong>Pi-GS: Sparse-View
                Gaussian Splatting with Dense π³ Initialization</strong><br>Manuel Hofer, Markus Steinberger, Thomas
                Köhler<br>
                <span class="talk-links">
                  <a class="link" href="assets/pdfs/CVWW2026-35-final.pdf" target="_blank" rel="noopener">Paper</a>
                </span>
              </span></li>
            </ul>
          </div>
        </div>
        <div class="published-panel">
          <div class="published-panel-body">
            <ul class="talk-list">
              <li class="accepted"><span class="talk-desc"><strong>Multi-Label
                Cardinality-Incremental Learning</strong><br>Laurenz Farthofer, Marc Masana<br>
                <span class="talk-links">
                  <a class="link" href="assets/pdfs/CVWW2026-07-final.pdf" target="_blank" rel="noopener">Paper</a>
                  <a class="link" href="assets/pdfs/CVWW2026-07-supplementary.pdf" target="_blank" rel="noopener">Suppl.</a>
                </span>
              </span></li>
            </ul>
          </div>
        </div>
        <div class="published-panel award" id="best-paper">
          <div class="published-panel-body">
            <ul class="talk-list">
              <li class="accepted">  
                <span class="talk-desc">
                  <span class="accepted-badge"><i class="fa-solid fa-trophy" aria-hidden="true"></i> &nbsp;Best Student Paper Award</span><br>
                  <strong>SAM-pose2seg: Pose-Guided Human Instance Segmentation in Crowds</strong><br>Constantin
                  Kolomiiets, Miroslav Purkrabek, Jiri Matas<br>
                  <span class="talk-links">
                    <a class="link" href="assets/pdfs/CVWW2026-29-final.pdf" target="_blank" rel="noopener">Paper</a>
                    <a class="link" href="assets/pdfs/CVWW2026-29-supplementary.pdf" target="_blank" rel="noopener">Suppl.</a>
                    <a class="link" href="https://arxiv.org/abs/2601.08982" rel="noopener" target="_blank">arXiv</a>
                    <a class="link" href="https://mirapurkrabek.github.io/BBox-Mask-Pose/" rel="noopener" target="_blank">Website</a>
                    <a class="link" href="https://github.com/MiraPurkrabek/BBoxMaskPose" rel="noopener" target="_blank">Code</a>
                  </span>
                </span>
              </li>
            </ul>
          </div>
        </div>
        <div class="published-panel candidate">
          <div class="published-panel-body">
            <ul class="talk-list">
              <li class="accepted"><span class="talk-desc">
                <span class="accepted-badge">Best Student Paper Candidate</span><br>
                <strong>Exploring Multimodal Large
                Language Models for Morphing Attack Detection</strong><br>Nikola Marić, Marija Ivanovska, Vitomir
                Štruc<br>
                <span class="talk-links">
                  <a class="link" href="assets/pdfs/CVWW2026-49-final.pdf" target="_blank" rel="noopener">Paper</a>
                  <a class="link" href="assets/pdfs/CVWW2026-49-supplementary.pdf" target="_blank" rel="noopener">Suppl.</a>
                </span>
              </span></li>
            </ul>
          </div>
        </div>
        <div class="published-panel candidate">
          <div class="published-panel-body">
            <ul class="talk-list">
              <li class="accepted"><span class="talk-desc">
                <span class="accepted-badge">Best Student Paper Candidate</span><br>
                <strong>Dynamic Ensemble of
                Deepfake Detectors Conditioned on CLIP Features</strong><br>Patricie Petriľáková, Jan Čech<br>
                <span class="talk-links">
                  <a class="link" href="assets/pdfs/CVWW2026-31-final.pdf" target="_blank" rel="noopener">Paper</a>
                </span>
              </span>
            </li>
          </ul>
        </div>
      </div>
      <div class="published-panel candidate">
        <div class="published-panel-body">
          <ul class="talk-list">
            <li class="accepted"><span class="talk-desc">
              <span class="accepted-badge">Best Student Paper Candidate</span><br>
              <strong>Dense Spatiotemporal
              Reconstruction of Sea Surface Temperature with Conditional Flow Matching</strong><br>Grega Rovšček,
              Matjaž Ličer, Matej Kristan<br>
              <span class="talk-links">
                <a class="link" href="assets/pdfs/CVWW2026-43-final.pdf" target="_blank" rel="noopener">Paper</a>
              </span>
            </span></li>
          </ul>
        </div>
      </div>
      <div class="published-panel">
        <div class="published-panel-body">
          <ul class="talk-list">
              <li class="accepted"><span class="talk-desc">
                <strong>Grading Handwritten
                    Engineering Exams with Multimodal Large Language Models</strong><br>Janez Perš, Jon Muhovič, Andrej
                  Košir, Boštjan Murovec<br>
                  <span class="talk-links">
                    <a class="link" href="assets/pdfs/CVWW2026-45-final.pdf" target="_blank" rel="noopener">Paper</a>
                  </span>
                </span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>


