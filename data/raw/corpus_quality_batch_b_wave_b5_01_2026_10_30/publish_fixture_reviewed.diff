 class AdminPublishWorkflowReliabilityTests(unittest.TestCase):
+    def test_publish_fixture_isolates_and_removes_its_sync_state(self):
+        default_paths = (
+            DEFAULT_STATE_PATH,
+            DEFAULT_STATE_PATH.with_suffix(".json.lock"),
+            DEFAULT_STATE_PATH.with_suffix(".json.export.lock"),
+            DEFAULT_STATE_PATH.with_suffix(".json.curated-change-intent"),
+        )
+
+        def default_state_bytes():
+            return {path: path.read_bytes() if path.exists() else None
+                    for path in default_paths}
+
+        before = default_state_bytes()
+        with RunningServer(lambda _name, *, progress: success_result()) as server:
+            coordinator = server.RequestHandlerClass.public_preview_sync
+            self.assertNotEqual(coordinator.state_path, DEFAULT_STATE_PATH)
+            temporary_root = coordinator.state_path.parent
+            self.assertFalse(coordinator.export_lock_path.exists())
+            status, result = request(
+                server, "/api/publish-changes", body={"confirmed": True}
+            )
+            self.assertEqual(status, 200)
+            self.assertTrue(result["success"])
+            self.assertTrue(coordinator.export_lock_path.is_file())
+            self.assertEqual(coordinator.export_lock_path.parent, temporary_root)
+            self.assertEqual(default_state_bytes(), before)
+        self.assertFalse(temporary_root.exists())
+        self.assertEqual(default_state_bytes(), before)
+
